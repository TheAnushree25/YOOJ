# Copy to .env.local for local development. Never commit the real value.
#
# DECK_KEY unlocks the sealed deck in deck/sealed and signs readers' passes.
# `npm run deck:seal -- path/to/deck.pdf` generates one into .env.local if it
# is missing. Set the same value in the host's environment variables (Vercel:
# Project Settings > Environment Variables) or /deck answers "unavailable".
DECK_KEY=
